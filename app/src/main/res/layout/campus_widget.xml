<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:breakStrategy="simple"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="PRATINJAU · Rabu"
        android:textColor="#2F6B4F"
        android:textSize="11sp" />

    <!-- No maxLines or ellipsize on time or room: stack and wrap rather than truncate. -->
    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:breakStrategy="simple"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:text="12:30–15:00"
        android:textColor="#14161A"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:breakStrategy="simple"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:text="A.3b.6"
        android:textColor="#14161A"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Pengantar Akuntansi"
        android:textColor="#14161A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:breakStrategy="simple"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:text="Kelas 01"
        android:textColor="#5E615B"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:breakStrategy="simple"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:text="Atur semester untuk mengaktifkan jadwal"
        android:textColor="#2F6B4F"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/widget_next_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="#D9D4C7"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="#2F6B4F"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_next_time_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:breakStrategy="simple"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textColor="#14161A"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_next_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#5E615B"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_data_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="Data --:--"
            android:textColor="#5E615B"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="WIB"
            android:textColor="#5E615B"
            android:textSize="10sp" />
        <!-- The launcher owns this clock; the application has no per-second timer. -->
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="HH:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:includeFontPadding="false"
            android:textColor="#14161A"
            android:textSize="11sp"
            android:timeZone="Asia/Jakarta" />
    </LinearLayout>
</LinearLayout>
