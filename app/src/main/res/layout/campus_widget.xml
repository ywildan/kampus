<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Primary occurrence: schedule text on the left, room code in its own badge on the right. -->
    <LinearLayout
        android:id="@+id/widget_primary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_primary_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="PRATINJAU · Rabu"
                android:textColor="#2F6B4F"
                android:textSize="11sp" />

            <!-- No maxLines or ellipsize on time: wrap rather than truncate. -->
            <TextView
                android:id="@+id/widget_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:breakStrategy="simple"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="12:30–15:00"
                android:textColor="#14161A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Empty / finished states have no room code, so they use this plain line instead. -->
            <TextView
                android:id="@+id/widget_room_plain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:breakStrategy="simple"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="A.3b.6"
                android:textColor="#14161A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_course"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Pengantar Akuntansi"
                android:textColor="#14161A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:breakStrategy="simple"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="Kelas 01"
                android:textColor="#5E615B"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:breakStrategy="simple"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="Atur semester untuk mengaktifkan jadwal"
                android:textColor="#2F6B4F"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- The emphasised element: room code only, vertically centred against the row. -->
        <LinearLayout
            android:id="@+id/widget_room_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_room_badge"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_room_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="RUANGAN"
                android:textColor="@color/campus_room_badge_label"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:breakStrategy="simple"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:text="A.3b.6"
                android:textColor="@color/campus_room_badge_ink"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Every remaining class of the primary's day is added here as a nested RemoteViews, so the
         widget is no longer limited to a single "next" row. -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Shown only when the card is too short to hold every remaining class. -->
    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:breakStrategy="simple"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#5E615B"
        android:textSize="10sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_data_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="Data --:--"
            android:textColor="#5E615B"
            android:textSize="10sp" />
        <!-- Launcher-driven countdown: the Chronometer ticks itself, so the app never repaints the
             widget per second. It replaces the "Data" stamp while visible; the live clock stays. -->
        <LinearLayout
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="MULAI DALAM"
                android:textColor="#2F6B4F"
                android:textSize="8.5sp" />
            <Chronometer
                android:id="@+id/widget_countdown_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:textColor="#14161A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- Absorbs the leftover width, so the zone and clock stay pinned right either way.
             A TextView, not Space: only the classes annotated @RemoteView may be inflated here. -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="WIB"
            android:textColor="#5E615B"
            android:textSize="10sp" />
        <!-- The launcher owns this clock; the application has no per-second timer. -->
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="HH:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:includeFontPadding="false"
            android:textColor="#14161A"
            android:textSize="11sp"
            android:timeZone="Asia/Jakarta" />
    </LinearLayout>
</LinearLayout>
